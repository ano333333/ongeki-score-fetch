{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.tf", "*.tfvars"],
      "options": {
        "parser": "hcl",
        "printWidth": 80,
        "tabWidth": 2
      }
    }
  ]
}
